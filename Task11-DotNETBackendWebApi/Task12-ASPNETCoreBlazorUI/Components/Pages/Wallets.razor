@page "/wallets"
@attribute [Authorize]
@using Shared.Models.DTOs
@using Task12_ASPNETCoreBlazorUI.Components.Dialogs
@using Task12_ASPNETCoreBlazorUI.Services.Contracts
@using Task12_ASPNETCoreBlazorUI.Models
@inject IWalletService WalletService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-4">Wallets</MudText>
    <MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
        CRUD for wallets.
    </MudText>

    @if (_walletsList == null)
    {
        <MudStack Spacing="4">
            <MudSkeleton Width="40%" Height="20px" />
            <MudSkeleton Width="100%" Height="56px" SkeletonType="SkeletonType.Rectangle" Class="rounded" />

            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="4"><MudSkeleton Width="100%" Height="40px" SkeletonType="SkeletonType.Rectangle" Class="rounded" /></MudItem>
                <MudItem xs="4"><MudSkeleton Width="100%" Height="40px" SkeletonType="SkeletonType.Rectangle" Class="rounded" /></MudItem>
                <MudItem xs="4"><MudSkeleton Width="100%" Height="40px" SkeletonType="SkeletonType.Rectangle" Class="rounded" /></MudItem>
            </MudGrid>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="6">

            <MudSelect T="WalletDto"
                       Label="Select a wallet:"
                       Variant="Variant.Outlined"
                       @bind-Value="_selectedWallet"
                       ToStringFunc="@(w => w == null ? "" : $"{w.Name}")">

                @foreach (var wallet in _walletsList)
                {
                    <MudSelectItem Value="@wallet" />
                }
            </MudSelect>

            <MudGrid Spacing="2" Justify="Justify.Center">

                <MudItem xs="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OnCreateClick">
                        Create
                    </MudButton>
                </MudItem>

                <MudItem xs="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Disabled="@(_selectedWallet == null)"
                               OnClick="OnEditClick">
                        Edit
                    </MudButton>
                </MudItem>

                <MudItem xs="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Delete"
                               Disabled="@(_selectedWallet == null)"
                               OnClick="OnDeleteClick">
                        Delete
                    </MudButton>
                </MudItem>

            </MudGrid>

            @if (_selectedWallet != null)
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Wallet name:</MudText>
                    <MudText Typo="Typo.body2">@_selectedWallet.Name</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Owner:</MudText>
                    <MudText Typo="Typo.body2">@_selectedWallet.User.Username</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Wallet currency:</MudText>
                    <MudText Typo="Typo.body2">@_selectedWallet.BaseCurrency.Code</MudText>
                </MudPaper>
            }

        </MudStack>
    }
</MudContainer>

@code {
    private List<WalletDto>? _walletsList;
    private WalletDto? _selectedWallet;
    private bool _isFirstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isFirstRender = false;

            await RefreshListAsync();
        }
    }

    private async Task RefreshListAsync()
    {
        try
        {
            _walletsList = await WalletService.GetListAsync();

            _selectedWallet = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"List update error: {ex.Message}", Severity.Error);
            _walletsList = new List<WalletDto>();
            StateHasChanged();
        }
    }
    
    private async Task OnCreateClick()
    {
        await OnButtonClick(FormMode.Create);
    }

    private async Task OnEditClick()
    {
        await OnButtonClick(FormMode.Update);
    }

    private async Task OnDeleteClick()
    {
        await OnButtonClick(FormMode.Delete);
    }

    private async Task OnButtonClick(FormMode mode)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<WalletDialog>
        {
            { x => x.WalletId, _selectedWallet?.Id ?? Guid.Empty },
            { x => x.Mode, mode }
        };

        var dialog = await DialogService.ShowAsync<WalletDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await RefreshListAsync();
        }
    }
}
