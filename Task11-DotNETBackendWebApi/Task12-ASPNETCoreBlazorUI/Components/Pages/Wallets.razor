@page "/wallets"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Sections
@using Shared.Models.DTOs
@using Task12_ASPNETCoreBlazorUI.Components.Dialogs
@using Task12_ASPNETCoreBlazorUI.Services.Contracts
@using Task12_ASPNETCoreBlazorUI.Models
@using Task12_ASPNETCoreBlazorUI.Components.Common
@inject IWalletService WalletService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<SectionContent SectionName="top-appbar-title">Wallets</SectionContent>

<GenericPageLayout TItem="WalletDto"
                IsLoading="@(_walletsList == null)"
                Items="@_walletsList"
                @bind-SelectedItem="_selectedWallet"
                OnCreate="OnCreateClick"
                OnEdit="OnEditClick"
                OnDelete="OnDeleteClick">
    <HeaderContent>
        <MudTh>Owner's name</MudTh>
        <MudTh>Wallet</MudTh>
        <MudTh>Wallet's currency</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Owner's name">@context.User.Username</MudTd>
        <MudTd DataLabel="Wallet">@context.Name</MudTd>
        <MudTd DataLabel="Wallet's currency">@context.BaseCurrency.Code</MudTd>
    </RowTemplate>
</GenericPageLayout>

@code {
    private List<WalletDto>? _walletsList;
    private WalletDto? _selectedWallet;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshListAsync();
        }
    }

    private async Task RefreshListAsync()
    {
        try
        {
            _walletsList = await WalletService.GetListAsync();
            _selectedWallet = null;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"List update error: {ex.Message}", Severity.Error);
            _walletsList = new List<WalletDto>();
            StateHasChanged();
        }
    }
    
    private async Task OnCreateClick()
    {
        await OnButtonClick(FormMode.Create);
    }

    private async Task OnEditClick()
    {
        await OnButtonClick(FormMode.Update);
    }

    private async Task OnDeleteClick()
    {
        await OnButtonClick(FormMode.Delete);
    }

    private async Task OnButtonClick(FormMode mode)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<WalletDialog>
        {
            { x => x.WalletId, _selectedWallet?.Id ?? Guid.Empty },
            { x => x.Mode, mode }
        };

        var dialog = await DialogService.ShowAsync<WalletDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await RefreshListAsync();
        }
    }
}
