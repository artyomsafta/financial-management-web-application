@page "/types"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Sections
@using Shared.Models.DTOs
@using Task12_ASPNETCoreBlazorUI.Components.Dialogs
@using Task12_ASPNETCoreBlazorUI.Services.Contracts
@using Task12_ASPNETCoreBlazorUI.Models
@using Task12_ASPNETCoreBlazorUI.Components.Common
@inject IFinancialTypeService FinancialTypeService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<SectionContent SectionName="top-appbar-title">Financial Types</SectionContent>

<GenericPageLayout TItem="FinancialTypeDto"
                IsLoading="@(_typesList == null)"
                Items="@_typesList"
                @bind-SelectedItem="_selectedType"
                OnCreate="OnCreateClick"
                OnEdit="OnEditClick"
                OnDelete="OnDeleteClick">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Is income</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Is income">@context.IsIncome</MudTd>
    </RowTemplate>
</GenericPageLayout>

@code {
    private List<FinancialTypeDto>? _typesList;
    private FinancialTypeDto? _selectedType;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshListAsync();
        }        
    }

    private async Task RefreshListAsync()
    {
        try
        {
            _typesList = await FinancialTypeService.GetListAsync();
            _selectedType = null;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"List update error: {ex.Message}", Severity.Error);
            _typesList = new List<FinancialTypeDto>();
            StateHasChanged();
        }
    }

    private async Task OnCreateClick()
    {
        await OnButtonClick(FormMode.Create);
    }

    private async Task OnEditClick()
    {
        await OnButtonClick(FormMode.Update);
    }

    private async Task OnDeleteClick()
    {
        await OnButtonClick(FormMode.Delete);
    }

    private async Task OnButtonClick(FormMode mode)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<TypeDialog>
        {
            { x => x.FinancialTypeId, _selectedType?.Id ?? Guid.Empty },
            { x => x.Mode, mode }
        };

        var dialog = await DialogService.ShowAsync<TypeDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await RefreshListAsync();
        }
    }
}
