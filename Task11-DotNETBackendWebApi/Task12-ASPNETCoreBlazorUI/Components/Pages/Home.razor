@page "/"
@inject NavigationManager Navigation

<PageTitle>Self finance - Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-12 mb-12">
    <MudPaper Class="pa-8 pa-md-12 rounded-xl" Elevation="4">
        <MudGrid AlignItems="AlignItems.Center" Spacing="4">

            <MudItem xs="12">
                <MudStack Spacing="3">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"
                                 Color="Color.Primary"
                                 Size="Size.Large" />
                        <MudText Typo="Typo.h3" Style="font-weight: 700;">
                            Financial Hub
                        </MudText>
                    </div>

                    <MudText Typo="Typo.h6" Color="Color.Secondary" Style="font-weight: 400;">
                        Blazor UI Frontend for .NET Web API
                    </MudText>

                    <MudDivider Class="my-3" />

                    <MudText Typo="Typo.body1" Class="text-secondary" Style="line-height: 1.6;">
                        Welcome to the application of managing self finance. This frontend is built with
                        <b>Blazor</b> and <b>MudBlazor</b> to provide a fast, responsive, and secure UI
                        for tracking your income, expenses, and analytics.
                    </MudText>
                </MudStack>
            </MudItem>

            <MudItem xs="12" Class="mt-4">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="4">
                        <MudPaper Class="pa-4 d-flex flex-column align-center text-center rounded-lg" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                            <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Class="mb-2" />
                            <MudText Typo="Typo.subtitle2">Financial Types</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Manage categories for income and expenses</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudPaper Class="pa-4 d-flex flex-column align-center text-center rounded-lg" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Success" Class="mb-2" />
                            <MudText Typo="Typo.subtitle2">Operations</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Track transactions in real-time</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudPaper Class="pa-4 d-flex flex-column align-center text-center rounded-lg" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                            <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Info" Class="mb-2" />
                            <MudText Typo="Typo.subtitle2">Reports</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Daily & period analytics with pagination</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudItem>

            <MudItem xs="12" Class="mt-6 d-flex gap-4 flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Login"
                           OnClick="@(() => Navigation.NavigateTo("/login"))">
                    Go to Login
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>
