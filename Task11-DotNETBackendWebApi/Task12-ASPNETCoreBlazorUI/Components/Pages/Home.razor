@page "/"
@using Microsoft.AspNetCore.Components.Sections
@inject NavigationManager NavigationManager

<PageTitle>Self finance - Home</PageTitle>
<SectionContent SectionName="top-appbar-title">Homepage</SectionContent>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-12 mb-12">
    <MudPaper Class="pa-8 pa-md-12 rounded-xl" Elevation="4">
        <MudGrid AlignItems="AlignItems.Center" Spacing="4">

            <MudItem xs="12">
                <MudStack Spacing="3">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"
                                 Color="Color.Primary"
                                 Size="Size.Large" />
                        <MudText Typo="Typo.h4" Style="font-weight: 700;">
                            Smart Cash Flow & Expenses Tracking
                        </MudText>
                    </div>

                    <MudDivider Class="my-3" />

                    <MudText Typo="Typo.body1" Class="text-secondary" Style="line-height: 1.6;">
                        Take full control of your finances with a centralized workspace built for clarity and speed. 
                        Easily track daily transactions, manage multiple wallets across currencies, and categorize every cash flow. 
                        Analyze your financial health using interactive reports and instantly export comprehensive summaries for 
                        accurate record-keeping.
                    </MudText>
                </MudStack>
            </MudItem>

            <MudItem xs="12" Class="mt-4">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="4">
                        <MudPaper Class="pa-4 d-flex flex-column align-center text-center rounded-lg" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                            <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Class="mb-2" />
                            <MudText Typo="Typo.subtitle2">Financial Types</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Categorize income streams and expense categories for complete visibility.</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudPaper Class="pa-4 d-flex flex-column align-center text-center rounded-lg" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Success" Class="mb-2" />
                            <MudText Typo="Typo.subtitle2">Operations</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Record, filter, and review transactions with multi-currency support.</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudPaper Class="pa-4 d-flex flex-column align-center text-center rounded-lg" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                            <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Info" Class="mb-2" />
                            <MudText Typo="Typo.subtitle2">Reports</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Analyze financial metrics with custom date ranges and instant PDF/CSV exports.</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudItem>

            <MudItem xs="12" Class="mt-6 d-flex gap-4 flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Login"
                           OnClick="@(() => NavigationManager.NavigateTo("/login"))">
                    Go to Login
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>
