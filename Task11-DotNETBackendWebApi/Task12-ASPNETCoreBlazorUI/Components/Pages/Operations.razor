@page "/operations"
@attribute [Authorize]
@using Shared.Models.DTOs
@using Task12_ASPNETCoreBlazorUI.Components.Dialogs
@using Task12_ASPNETCoreBlazorUI.Services.Contracts
@using Task12_ASPNETCoreBlazorUI.Models
@inject IFinancialOperationService FinancialOperationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-4">Financial operations</MudText>
    <MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
        CRUD for financial operations.
    </MudText>

    @if (_operationsList == null)
    {
        <MudStack Spacing="4">
            <MudSkeleton Width="40%" Height="20px" />
            <MudSkeleton Width="100%" Height="56px" SkeletonType="SkeletonType.Rectangle" Class="rounded" />

            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="4"><MudSkeleton Width="100%" Height="40px" SkeletonType="SkeletonType.Rectangle" Class="rounded" /></MudItem>
                <MudItem xs="4"><MudSkeleton Width="100%" Height="40px" SkeletonType="SkeletonType.Rectangle" Class="rounded" /></MudItem>
                <MudItem xs="4"><MudSkeleton Width="100%" Height="40px" SkeletonType="SkeletonType.Rectangle" Class="rounded" /></MudItem>
            </MudGrid>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="6">

            <MudSelect T="FinancialOperationDto"
                       Label="Select a financial operation:"
                       Variant="Variant.Outlined"
                       @bind-Value="_selectedOperation"
                       ToStringFunc="@(o => o == null ? "" : $"{o.Date}")">

                @foreach (var operation in _operationsList)
                {
                    <MudSelectItem Value="@operation" />
                }
            </MudSelect>

            <MudGrid Spacing="2" Justify="Justify.Center">

                <MudItem xs="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OnCreateClick">
                        Create
                    </MudButton>
                </MudItem>

                <MudItem xs="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Disabled="@(_selectedOperation == null)"
                               OnClick="OnEditClick">
                        Edit
                    </MudButton>
                </MudItem>

                <MudItem xs="4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Delete"
                               Disabled="@(_selectedOperation == null)"
                               OnClick="OnDeleteClick">
                        Delete
                    </MudButton>
                </MudItem>

            </MudGrid>

            @if (_selectedOperation != null)
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.subtitle2">Operation date:</MudText>
                    <MudText Typo="Typo.caption" Class="mt-2">@_selectedOperation.Date</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Wallet:</MudText>
                    <MudText Typo="Typo.body2">@_selectedOperation.Wallet.Name</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Type:</MudText>
                    <MudText Typo="Typo.body2">@_selectedOperation.Type.Name</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Currency:</MudText>
                    <MudText Typo="Typo.body2">@_selectedOperation.Currency.Code</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Amount:</MudText>
                    <MudText Typo="Typo.body2">@_selectedOperation.Amount</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Comment:</MudText>
                    <MudText Typo="Typo.body2">@_selectedOperation.Comment</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Notes:</MudText>
                    <MudText Typo="Typo.body2">@_selectedOperation.Note</MudText>
                </MudPaper>
            }

        </MudStack>
    }
</MudContainer>

@code {
    private List<FinancialOperationDto>? _operationsList;
    private FinancialOperationDto? _selectedOperation;
    private bool _isFirstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isFirstRender = false;

            await RefreshListAsync();
        }        
    }

    private async Task RefreshListAsync()
    {
        try
        {
            _operationsList = await FinancialOperationService.GetListAsync();

            _selectedOperation = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"List update error: {ex.Message}", Severity.Error);
            _operationsList = new List<FinancialOperationDto>();
            StateHasChanged();
        }
    }

    private async Task OnCreateClick()
    {
        await OnButtonClick(FormMode.Create);
    }

    private async Task OnEditClick()
    {
        await OnButtonClick(FormMode.Update);
    }

    private async Task OnDeleteClick()
    {
        await OnButtonClick(FormMode.Delete);
    }

    private async Task OnButtonClick(FormMode mode)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<OperationDialog>
        {
            { x => x.FinancialOperationId, _selectedOperation?.Id ?? Guid.Empty },
            { x => x.Mode, mode }
        };

        var dialog = await DialogService.ShowAsync<OperationDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await RefreshListAsync();
        }
    }
}
