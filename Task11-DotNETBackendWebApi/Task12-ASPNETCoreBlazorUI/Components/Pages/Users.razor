@page "/users"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Sections
@using Shared.Models.DTOs
@using Task12_ASPNETCoreBlazorUI.Components.Dialogs
@using Task12_ASPNETCoreBlazorUI.Services.Contracts
@using Task12_ASPNETCoreBlazorUI.Models
@using Task12_ASPNETCoreBlazorUI.Components.Common
@inject IUserService UserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<SectionContent SectionName="top-appbar-title">Users</SectionContent>

<GenericPageLayout TItem="UserDto"
                IsLoading="@(_usersList == null)"
                Items="@_usersList"
                @bind-SelectedItem="_selectedUser"
                OnCreate="OnCreateClick"
                OnEdit="OnEditClick"
                OnDelete="OnDeleteClick">
    <HeaderContent>
        <MudTh>Username</MudTh>
        <MudTh>Role</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Username">@context.Username</MudTd>
        <MudTd DataLabel="Role">@context.Role</MudTd>
    </RowTemplate>
</GenericPageLayout>

@code {
    private List<UserDto>? _usersList;
    private UserDto? _selectedUser;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshListAsync();
        }
    }

    private async Task RefreshListAsync()
    {
        try
        {
            _usersList = await UserService.GetListAsync();
            _selectedUser = null;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"List update error: {ex.Message}", Severity.Error);
            _usersList = new List<UserDto>();
            StateHasChanged();
        }
    }
    
    private async Task OnCreateClick()
    {
        await OnButtonClick(FormMode.Create);
    }

    private async Task OnEditClick()
    {
        await OnButtonClick(FormMode.Update);
    }

    private async Task OnDeleteClick()
    {
        await OnButtonClick(FormMode.Delete);
    }

    private async Task OnButtonClick(FormMode mode)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.UserId, _selectedUser?.Id ?? Guid.Empty },
            { x => x.Mode, mode }
        };

        var dialog = await DialogService.ShowAsync<UserDialog>("", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await RefreshListAsync();
        }
    }
}
