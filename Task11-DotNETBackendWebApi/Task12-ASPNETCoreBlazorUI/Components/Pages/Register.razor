@page "/register"
@using Shared.Models
@inject NavigationManager NavigationManager
@inject IHttpClientFactory ClientFactory
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudCard Elevation="4" Class="pa-6 rounded-lg">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center"><b>Registration</b></MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <MudForm @ref="form" @bind-IsValid="@success">
                <MudStack Spacing="4">

                    <MudTextField T="string"
                                  Label="Login:"
                                  @bind-Value="model.Username"
                                  Required="true"
                                  Variant="Variant.Outlined" />

                    <MudTextField T="string"
                                  Label="Password:"
                                  @bind-Value="model.Password"
                                  Required="true"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined" />

                </MudStack>
            </MudForm>
        </MudCardContent>

        <MudCardActions Class="d-flex justify-space-between px-4 mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Disabled="@(!success || isProcessing)"
                       OnClick="HandleRegisterAsync">
                @if (isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Register
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm form = default!;
    private bool success;
    private bool isProcessing;

    private UserRegisterRequest model = new();

    private async Task HandleRegisterAsync()
    {
        await form.ValidateAsync();
        if (!form.IsValid)
            return;

        isProcessing = true;

        try
        {
            var client = ClientFactory.CreateClient("Api");
            var response = await client.PostAsJsonAsync("Users", model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Registration successful!", Severity.Success);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add(!string.IsNullOrWhiteSpace(errorText) ? errorText : "Server error", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error connecting to server: {ex.Message}", Severity.Error);
        }
        finally
        {
            isProcessing = false;
        }
    }
}
