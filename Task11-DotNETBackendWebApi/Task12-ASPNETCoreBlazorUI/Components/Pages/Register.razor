@page "/register"
@using Shared.Models
@using Task12_ASPNETCoreBlazorUI.Services.Contracts
@inject NavigationManager NavigationManager
@inject IUserService UserService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudCard Elevation="4" Class="pa-6 rounded-lg">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center"><b>Registration</b></MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <MudForm @ref="_form">
                <MudStack Spacing="4">

                    <MudTextField T="string"
                                  Label="Login:"
                                  @bind-Value="_model.Username"
                                  Required="true"
                                  Variant="Variant.Outlined" />

                    <MudTextField T="string"
                                  Label="Password:"
                                  @bind-Value="_model.Password"
                                  Required="true"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined" />

                </MudStack>
            </MudForm>
        </MudCardContent>

        <MudCardActions Class="d-flex justify-space-between px-4 mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Disabled="@_isProcessing"
                       OnClick="HandleRegisterAsync">
                @if (_isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Register
            </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private MudForm _form = default!;
    private bool _isProcessing;

    private UserRegisterRequest _model = new();

    private async Task HandleRegisterAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        _isProcessing = true;

        try
        {
            var response = await UserService.CreateAsync(_model);

            if (response.IsSuccess)
            {
                Snackbar.Add(response.Message, Severity.Success);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add(response.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error connecting to server: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
