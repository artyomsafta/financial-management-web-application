@using Shared.Models
@using Shared.Models.DTOs
@using Task12_ASPNETCoreBlazorUI.Services.Contracts
@inject IAuthService AuthService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Class="mr-3" />
            Financial operation editing
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudStack Spacing="4">
                <MudTextField T="DateTime"
                              Label="Date"
                              @bind-Value="model.Date"
                              Required="true"
                              RequiredError="Date is required"
                              Variant="Variant.Outlined" />

                <MudSelect T="Guid"
                           Label="Type"
                           @bind-Value="model.TypeId"
                           Required="true"
                           RequiredError="Type is required"
                           Variant="Variant.Outlined">
                    @if (TypesList != null)
                    {
                        @foreach (var type in TypesList)
                        {
                            <MudSelectItem Value="@type.Id">
                                @type.Name
                            </MudSelectItem>
                        }
                    }
                </MudSelect>

                <MudSelect T="Guid"
                           Label="Wallet"
                           @bind-Value="model.WalletId"
                           Required="true"
                           RequiredError="Wallet is required"
                           Variant="Variant.Outlined">
                    @if (WalletsList != null)
                    {
                        @foreach (var wallet in WalletsList)
                        {
                            <MudSelectItem Value="@wallet.Id">
                                @wallet.Name
                            </MudSelectItem>
                        }
                    }
                </MudSelect>

                <MudTextField T="string"
                              Label="Currency"
                              @bind-Value="model.Currency"
                              Required="true"
                              RequiredError="Currency is required"
                              Variant="Variant.Outlined" />

                <MudTextField T="decimal"
                              Label="Amount"
                              @bind-Value="model.Amount"
                              Required="true"
                              RequiredError="Amount is required"
                              Variant="Variant.Outlined" />

                <MudTextField T="string"
                              Label="Notes"
                              @bind-Value="model.Note"
                              Required="false"
                              Variant="Variant.Outlined" />

            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(!success || isSending)"
                   OnClick="Submit">
            @if (isSending)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Saving...</MudText>
            }
            else
            {
                <MudText>Update</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public List<FinancialTypeDto>? TypesList { get; set; }

    [Parameter]
    public List<WalletDto>? WalletsList { get; set; }

    [Parameter]
    public Guid FinancialOperationId { get; set; }

    [Parameter]
    public FinancialOperationDto? InitialData { get; set; }

    private MudForm form = default!;
    private bool success;
    private bool isSending;

    private CreateFinOperationRequest model = new();

    protected override void OnInitialized()
    {
        if (InitialData != null)
        {
            model.TypeId = InitialData.Type.Id;
            model.WalletId = InitialData.Wallet.Id;
            model.Amount = InitialData.Amount;
            model.Date = InitialData.Date;
            model.Currency = InitialData.Currency.Code;
            model.Note = InitialData.Note;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!form.IsValid) return;

        isSending = true;
        try
        {
            var client = await AuthService.CreateAuthenticatedClientAsync();
            var response = await client.PutAsJsonAsync($"api/v1/FinancialOperations/{FinancialOperationId}", model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Financial operation updated successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add(!string.IsNullOrWhiteSpace(errorText) ? errorText : "Server error", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Critical error occurred while submitting: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSending = false;
        }
    }
}
