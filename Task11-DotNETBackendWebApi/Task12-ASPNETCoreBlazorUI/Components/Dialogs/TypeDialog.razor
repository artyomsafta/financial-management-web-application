@using Shared.Models.DTOs
@using Task12_ASPNETCoreBlazorUI.Services.Contracts
@using Task12_ASPNETCoreBlazorUI.Models
@inject IFinancialTypeService FinancialTypeService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@GetDialogIcon()" Class="mr-3" />
            @GetDialogTitle()
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Disabled="@(Mode == FormMode.Delete)">
            <MudStack Spacing="4">

                <MudTextField T="string"
                              Label="Name"
                              @bind-Value="_model.Name"
                              Required="true"
                              RequiredError="Name is required"
                              Variant="Variant.Outlined" />

                <MudTextField T="string"
                              Label="Description"
                              @bind-Value="_model.Description"
                              Lines="3"
                              Variant="Variant.Outlined" />

                <MudSwitch T="bool"
                           @bind-Value="_model.IsIncome"
                           Color="Color.Success"
                           UncheckedColor="Color.Error"
                           Label="@(_model.IsIncome ? "This is Income" : "This is Expense")" />

            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="@(Mode != FormMode.Delete ? Color.Primary : Color.Error)"
                   Variant="Variant.Filled"
                   Disabled="@_isSending"
                   OnClick="Submit">
            @if (_isSending)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Saving...</MudText>
            }
            else
            {
                <MudText>@GetSubmitButtonText()</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public FormMode Mode { get; set; }

    [Parameter]
    public Guid FinancialTypeId { get; set; }

    private MudForm _form = default!;
    private bool _isSending;

    private FinancialTypeDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        if (Mode != FormMode.Create)
            _model = await FinancialTypeService.GetByIdAsync(FinancialTypeId);

        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();
    
    private async Task Submit()
    {

        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        _isSending = true;

        try
        {
            var response = new ApiResponseDto();

            switch (Mode)
            {
                case FormMode.Create:
                    response = await FinancialTypeService.CreateAsync(_model);
                    break;
                case FormMode.Update:
                    response = await FinancialTypeService.UpdateAsync(FinancialTypeId, _model);
                    break;
                case FormMode.Delete:
                    response = await FinancialTypeService.DeleteAsync(FinancialTypeId);
                    break;
                default:
                    throw new InvalidOperationException("Invalid form mode.");
            }

            if (response.IsSuccess)
            {
                Snackbar.Add(response.Message, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Critical error occurred while submitting: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSending = false;
        }
    }

    private string GetDialogIcon() => Mode switch
    {
        FormMode.Create => Icons.Material.Filled.AddCard,
        FormMode.Update => Icons.Material.Filled.EditNote,
        FormMode.Delete => Icons.Material.Filled.DeleteForever,
        _ => Icons.Material.Filled.Info
    };

    private string GetDialogTitle() => Mode switch
    {
        FormMode.Create => "Financial type creation",
        FormMode.Update => "Financial type editing",
        FormMode.Delete => "Delete financial type",
        _ => "Dialog"
    };

    private string GetSubmitButtonText() => Mode switch
    {
        FormMode.Create => "Create",
        FormMode.Update => "Update",
        FormMode.Delete => "Delete",
        _ => "OK"
    };
}
