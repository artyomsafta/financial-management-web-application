@using Shared.Models
@using Shared.Models.DTOs
@using Task12_ASPNETCoreBlazorUI.Services.Contracts
@inject IAuthService AuthService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Class="mr-3" />
            Financial type editing
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudStack Spacing="4">

                <MudTextField T="string"
                              Label="Name"
                              @bind-Value="model.Name"
                              Required="true"
                              RequiredError="Name is required"
                              Variant="Variant.Outlined" />

                <MudTextField T="string"
                              Label="Description"
                              @bind-Value="model.Description"
                              Lines="3"
                              Variant="Variant.Outlined" />

                <MudSwitch T="bool"
                           @bind-Value="model.IsIncome"
                           Color="Color.Success"
                           UncheckedColor="Color.Error"
                           Label="@(model.IsIncome ? "This is Income" : "This is Expense")" />

            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(!success || isSending)"
                   OnClick="Submit">
            @if (isSending)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Saving...</MudText>
            }
            else
            {
                <MudText>Update</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid FinancialTypeId { get; set; }

    [Parameter]
    public FinancialTypeDto? InitialData { get; set; }

    private MudForm form = default!;
    private bool success;
    private bool isSending;

    private FinancialTypeRequest model = new();

    protected override void OnInitialized()
    {
        if (InitialData != null)
        {
            model.Name = InitialData.Name;
            model.Description = InitialData.Description;
            model.IsIncome = InitialData.IsIncome;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!form.IsValid) return;

        isSending = true;
        try
        {
            var client = await AuthService.CreateAuthenticatedClientAsync();
            var response = await client.PutAsJsonAsync($"FinancialTypes/{FinancialTypeId}", model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Financial type updated successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Snackbar.Add(!string.IsNullOrWhiteSpace(errorText) ? errorText : "Server error", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Critical error occurred while submitting: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSending = false;
        }
    }
}
