@using Microsoft.AspNetCore.Components.Authorization
<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">Homepage</MudNavLink>
    <MudNavLink Href="/login" Match="NavLinkMatch.Prefix">Login</MudNavLink>
    <AuthorizeView>
        <Authorized>
            <MudNavGroup Title="Sections" Expanded="true">
                <MudNavLink Href="/users" Match="NavLinkMatch.Prefix">Users</MudNavLink>
                <MudNavLink Href="/types" Match="NavLinkMatch.Prefix">Financial Types</MudNavLink>
                <MudNavLink Href="/wallets" Match="NavLinkMatch.Prefix">Wallets</MudNavLink>
                <MudNavLink Href="/operations" Match="NavLinkMatch.Prefix">Financial Operations</MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="Reports" Expanded="true">
                <MudNavLink Href="/daily-report" Match="NavLinkMatch.Prefix">Daily</MudNavLink>
                <MudNavLink Href="/period-report" Match="NavLinkMatch.Prefix">Period</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
