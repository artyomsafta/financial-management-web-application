# Copy to .env for local Docker Compose use. Replace every placeholder locally.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-sql-password
JWT_KEY=replace-with-a-long-random-jwt-signing-key
BOOTSTRAP_ADMIN_USERNAME=replace-with-initial-admin-username
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-admin-password
